{
  "manifest_version": 3,
  "name": "KH Auto Next",
  "version": "1.3.19",
  "description": "Tự động chọn Đơn vị + điền Mã KH + bấm Tìm kiếm + chấm theo chương trình + popup gallery ảnh trên trang Quản lý media",
  "permissions": ["storage", "activeTab", "scripting", "clipboardRead"],
  "host_permissions": ["https://mocchau.dmsone.vn/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KH Auto Next"
  },
  "content_scripts": [
    {
      "matches": ["https://mocchau.dmsone.vn/*"],
      "js": ["keymap.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://mocchau.dmsone.vn/*"]
    }
  ]
}
